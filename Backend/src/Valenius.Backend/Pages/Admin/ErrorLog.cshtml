@page
@model Valenius.Backend.Pages.Admin.ErrorLogModel
@{
    ViewData["Title"] = "Error Log";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Error Log</h1>
    <small class="text-muted">Latest 200 errors</small>
</div>

@if (!Model.Errors.Any())
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        No errors recorded.
    </div>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-clock me-1"></i>Time</th>
                    <th><i class="bi bi-link-45deg me-1"></i>Request path</th>
                    <th><i class="bi bi-exclamation-triangle me-1"></i>Exception</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var err in Model.Errors)
                {
                    var rowId = $"stack-{err.Id}";
                    <tr class="align-top" style="cursor:pointer"
                        data-bs-toggle="collapse" data-bs-target="#@rowId">
                        <td class="text-muted small text-nowrap">@err.OccurredAt.ToVienna().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="small text-muted">@(err.RequestPath ?? "-")</td>
                        <td class="small fw-semibold text-danger">@(err.ExceptionType?.Split('.').LastOrDefault() ?? "-")</td>
                        <td class="small">@err.Message</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(err.StackTrace))
                    {
                        <tr class="collapse" id="@rowId">
                            <td colspan="4" class="bg-light p-0">
                                <pre class="mb-0 p-3" style="font-size:.75rem;white-space:pre-wrap;word-break:break-all">@err.StackTrace</pre>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
