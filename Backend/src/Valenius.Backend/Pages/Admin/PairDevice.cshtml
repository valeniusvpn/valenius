@page "{customerId:int}"
@model Valenius.Backend.Pages.Admin.PairDeviceModel
@{
    ViewData["Title"] = $"Pair device - {Model.CustomerName}";
}

<div class="mb-3">
    <a asp-page="/Admin/Customers/Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to customer
    </a>
</div>

<div class="card mx-auto" style="max-width: 440px;">
    <div class="card-body text-center">
        <h1 class="h5 mb-2">Pair a mobile device</h1>
        <p class="text-muted small mb-3">
            Scan this code in the Valenius mobile app to activate the device and assign it to
            <strong>@Model.CustomerName</strong>.
        </p>
        <img src="data:image/png;base64,@Model.QrBase64" alt="Pairing QR code"
             class="img-fluid my-2" style="max-width: 280px;" />
        <p class="text-muted small mb-1 mt-3">Pairing code</p>
        <p class="font-monospace fs-5 mb-3">@Model.Code</p>
        <p class="text-muted small mb-0">
            Expires in @Model.ExpiryMinutes minutes. Reload the page for a new code.
        </p>
    </div>
</div>
