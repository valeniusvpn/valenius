@page
@model Valenius.Backend.Pages.Admin.AlertsModel
@{
    ViewData["Title"] = "Security Alerts";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <i class="bi bi-shield-exclamation text-warning" style="font-size:1.4rem;"></i>
    <h1 class="page-title mb-0">Security Alerts</h1>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ── Unacknowledged alerts ─────────────────────────────────────────────── -->
@if (Model.UnacknowledgedAlerts.Count == 0)
{
    <div class="alert alert-success py-2 mb-3" style="max-width:760px;">
        <i class="bi bi-check-circle me-1"></i>No unacknowledged security alerts.
    </div>
}
else
{
    <div class="alert alert-warning py-2 mb-3" style="max-width:760px;">
        <i class="bi bi-exclamation-triangle me-1"></i>
        <strong>@Model.UnacknowledgedAlerts.Count unacknowledged alert(s).</strong>
        A sidecar re-enrolled — its previous certificate was revoked and a new one was issued.
        Review the details below and dismiss once you have verified the re-enrollment was intentional.
    </div>

    @foreach (var alert in Model.UnacknowledgedAlerts)
    {
        <div class="card border-warning mb-3" style="max-width:760px;">
            <div class="card-header bg-warning bg-opacity-10 d-flex align-items-center justify-content-between">
                <span><i class="bi bi-arrow-repeat me-2 text-warning"></i>Re-enrollment — <strong>@alert.CustomerName</strong></span>
                <form method="post" asp-page-handler="Acknowledge" asp-route-id="@alert.Id">
                    <button type="submit" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-check2 me-1"></i>Acknowledge
                    </button>
                </form>
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-4">Time</dt>
                    <dd class="col-sm-8">@alert.CreatedAt.ToVienna().ToString("dd.MM.yyyy HH:mm") (Vienna)</dd>
                    <dt class="col-sm-4">Enrolling IP</dt>
                    <dd class="col-sm-8"><code>@alert.EnrollingIp</code></dd>
                    <dt class="col-sm-4">Old cert (revoked)</dt>
                    <dd class="col-sm-8"><code class="text-danger">@alert.OldFingerprint</code></dd>
                    <dt class="col-sm-4">New cert (active)</dt>
                    <dd class="col-sm-8"><code class="text-success">@alert.NewFingerprint</code></dd>
                </dl>
            </div>
        </div>
    }
}

<!-- ── Acknowledged alerts ───────────────────────────────────────────────── -->
@if (Model.AcknowledgedAlerts.Count > 0)
{
    <details class="mb-4" style="max-width:760px;">
        <summary class="text-muted small mb-2" style="cursor:pointer;">
            Show @Model.AcknowledgedAlerts.Count acknowledged alert(s)
        </summary>
        <div class="table-responsive mt-2">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>Customer</th><th>Time</th><th>IP</th><th>Old cert</th><th>New cert</th></tr></thead>
                <tbody>
                @foreach (var a in Model.AcknowledgedAlerts)
                {
                    <tr class="text-muted">
                        <td>@a.CustomerName</td>
                        <td class="text-nowrap small">@a.CreatedAt.ToVienna().ToString("dd.MM.yyyy HH:mm")</td>
                        <td><code class="small">@a.EnrollingIp</code></td>
                        <td><code class="small">@a.OldFingerprint</code></td>
                        <td><code class="small">@a.NewFingerprint</code></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </details>
}

<!-- ── Client repair reports ────────────────────────────────────────────── -->
@{
    var needsAttention = Model.UnacknowledgedClientAlerts.Where(a => !a.IsInformational).ToList();
    var informational  = Model.UnacknowledgedClientAlerts.Where(a =>  a.IsInformational).ToList();
}
@if (needsAttention.Count > 0)
{
    <div class="alert alert-warning py-2 mb-3" style="max-width:760px;">
        <i class="bi bi-exclamation-triangle me-1"></i>
        <strong>@needsAttention.Count client(s) could not self-repair.</strong>
        A client ran its local repair checks and could not fully fix the problem itself — this can
        mean the machine's local state was tampered with (not just an ordinary permission glitch).
        Review each one below.
    </div>
}
@if (informational.Count > 0)
{
    <div class="alert alert-info py-2 mb-3" style="max-width:760px;">
        <i class="bi bi-info-circle me-1"></i>
        <strong>@informational.Count client(s) needed a forced ownership repair.</strong>
        The repair succeeded automatically and the user was unaffected — shown here because an
        object under a folder only SYSTEM should ever write to had lost SYSTEM ownership, which is
        unusual and worth knowing about if it recurs.
    </div>
}

@foreach (var alert in Model.UnacknowledgedClientAlerts)
{
    var danger = !alert.IsInformational;
    <div class="card @(danger ? "border-warning" : "border-info") mb-3" style="max-width:760px;">
        <div class="card-header @(danger ? "bg-warning" : "bg-info") bg-opacity-10 d-flex align-items-center justify-content-between">
            <span>
                <i class="bi @(danger ? "bi-exclamation-diamond text-warning" : "bi-info-circle text-info") me-2"></i>
                <a asp-page="/Admin/Details" asp-route-id="@alert.ClientId">@alert.ClientName</a>
                — @alert.Label
            </span>
            <form method="post" asp-page-handler="AcknowledgeClientAlert" asp-route-id="@alert.Id">
                <button type="submit" class="btn @(danger ? "btn-outline-warning" : "btn-outline-info") btn-sm">
                    <i class="bi bi-check2 me-1"></i>Acknowledge
                </button>
            </form>
        </div>
        <div class="card-body">
            <dl class="row mb-0 small">
                <dt class="col-sm-3">Time</dt>
                <dd class="col-sm-9">@alert.CreatedAt.ToVienna().ToString("dd.MM.yyyy HH:mm") (Vienna)</dd>
                @if (!string.IsNullOrEmpty(alert.Detail))
                {
                    <dt class="col-sm-3">Detail</dt>
                    <dd class="col-sm-9"><code class="small">@alert.Detail</code></dd>
                }
            </dl>
        </div>
    </div>
}

@if (Model.AcknowledgedClientAlerts.Count > 0)
{
    <details class="mb-4" style="max-width:760px;">
        <summary class="text-muted small mb-2" style="cursor:pointer;">
            Show @Model.AcknowledgedClientAlerts.Count acknowledged client alert(s)
        </summary>
        <div class="table-responsive mt-2">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>Client</th><th>Kind</th><th>Time</th><th>Detail</th></tr></thead>
                <tbody>
                @foreach (var a in Model.AcknowledgedClientAlerts)
                {
                    <tr class="text-muted">
                        <td><a asp-page="/Admin/Details" asp-route-id="@a.ClientId">@a.ClientName</a></td>
                        <td class="small">@a.Label</td>
                        <td class="text-nowrap small">@a.CreatedAt.ToVienna().ToString("dd.MM.yyyy HH:mm")</td>
                        <td><code class="small">@a.Detail</code></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </details>
}

<!-- ── CA certificate download ──────────────────────────────────────────── -->
<div class="card mb-3" style="max-width:760px;">
    <div class="card-header">
        <i class="bi bi-patch-check me-2"></i>Internal CA Certificate
    </div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            This is the CA certificate used to sign all sidecar mTLS certificates.
            It is safe to share. Import it into tools that need to verify sidecar connections.
            The CA private key is never available for download — it is included only in the encrypted backup export.
        </p>
        <a asp-page-handler="DownloadCa" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Download CA certificate (.crt)
        </a>
        <details class="mt-3">
            <summary class="text-muted small" style="cursor:pointer;">Show PEM</summary>
            <pre class="mt-2 p-2 border rounded small" style="word-break:break-all;white-space:pre-wrap;">@Model.CaCertPem</pre>
        </details>
    </div>
</div>
