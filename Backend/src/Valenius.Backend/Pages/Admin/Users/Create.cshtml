@page
@model Valenius.Backend.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Create User";
}

<div class="mb-3">
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to users
    </a>
</div>

<div class="d-flex align-items-center gap-2 mb-4">
    <i class="bi bi-person-plus text-primary" style="font-size:1.4rem;"></i>
    <h1 class="page-title mb-0">Create local user</h1>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger py-2" role="alert">
        <i class="bi bi-x-circle me-1"></i>@Model.Error
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><i class="bi bi-person-lock me-2"></i>New user details</div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Display name</label>
                        <input type="text" asp-for="DisplayName" class="form-control form-control-sm"
                               autofocus required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email <span class="text-muted fw-normal">(used to sign in)</span></label>
                        <input type="email" asp-for="Email" class="form-control form-control-sm" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Role</label>
                        <select asp-for="Role" class="form-select form-select-sm">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Customer <span class="text-muted fw-normal">(optional)</span></label>
                        <select asp-for="CustomerId" class="form-select form-select-sm">
                            <option value="">-- None --</option>
                            @foreach (var c in Model.AllCustomers)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>

                    <hr class="my-3" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Password <span class="text-muted fw-normal">(optional — can be set later)</span>
                        </label>
                        <input type="password" asp-for="Password" class="form-control form-control-sm"
                               autocomplete="new-password" minlength="8" />
                        <div class="form-text">Minimum 8 characters. Leave blank to set the password later on the Edit page.</div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-person-check me-1"></i>Create user
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
