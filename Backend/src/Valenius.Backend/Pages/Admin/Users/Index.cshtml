@page
@model Valenius.Backend.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Users</h1>
    <a asp-page="./Create" class="btn btn-primary btn-sm">
        <i class="bi bi-person-plus me-1"></i>Create local user
    </a>
</div>

@if (!Model.Users.Any())
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill"></i>
        No users yet. Users appear here after their first OIDC login, or when created manually.
    </div>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-person me-1"></i>Display name</th>
                    <th><i class="bi bi-envelope me-1"></i>Email</th>
                    <th><i class="bi bi-shield me-1"></i>Role</th>
                    <th><i class="bi bi-building me-1"></i>Customer</th>
                    <th><i class="bi bi-key me-1"></i>Auth</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold">@u.DisplayName</td>
                        <td class="text-muted small">@(u.Email ?? "-")</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge bg-primary"><i class="bi bi-shield-fill me-1"></i>Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-person-fill me-1"></i>User</span>
                            }
                        </td>
                        <td class="text-muted small">@(u.CustomerName ?? "-")</td>
                        <td>
                            @if (u.IsLocal)
                            {
                                @if (u.HasPassword)
                                {
                                    <span class="badge bg-success" title="Local user with password set">
                                        <i class="bi bi-person-lock me-1"></i>Local
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning" title="Local user — no password set">
                                        <i class="bi bi-exclamation-triangle me-1"></i>No password
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-info text-dark" title="Authentik / OIDC user">
                                    <i class="bi bi-shield-check me-1"></i>OIDC
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="./Edit" asp-route-id="@u.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
