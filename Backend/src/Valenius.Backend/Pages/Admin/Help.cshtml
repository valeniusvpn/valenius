@page
@model Valenius.Backend.Pages.Admin.HelpModel
@{
    ViewData["Title"] = "Help";
}

@*
    Thin launcher only — the actual help content lives on help.valenius.com
    (source: help/ in the repo). Don't add content here; add or fix pages
    there instead. Concept: docs/help.md.
*@

<style>
    .help-card {
        border: 1px solid #e0e8ef;
        border-radius: 12px;
        background: #fff;
        height: 100%;
        display: block;
        padding: 1.4rem 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: box-shadow .15s ease, transform .15s ease;
    }
    .help-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); transform: translateY(-2px); color: inherit; }
    .help-card .hc-icon { font-size: 1.9rem; line-height: 1; color: var(--brand-primary); }
    .help-card h5 { font-weight: 600; margin: .75rem 0 .35rem; color: var(--brand-primary); }
    .help-card p { font-size: .875rem; color: #6c757d; margin-bottom: 0; line-height: 1.55; }
    .help-topics a {
        display: inline-block;
        font-size: .82rem;
        color: var(--brand-primary);
        background: #f0f4f7;
        border: 1px solid #e0e8ef;
        border-radius: 999px;
        padding: .3rem .8rem;
        margin: 0 .35rem .5rem 0;
        text-decoration: none;
    }
    .help-topics a:hover { background: #e4ecf2; }
</style>

<h1 class="page-title mb-1">Help</h1>
<p class="text-muted mb-4" style="font-size:.9rem;">
    All guides live on the Valenius help site — task-oriented, always current, and open to your users too.
</p>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <a class="help-card" href="https://help.valenius.com/install/" target="_blank" rel="noopener">
            <i class="bi bi-download hc-icon"></i>
            <h5>Installation guides</h5>
            <p>Step-by-step setup for every component — backend, integrated WireGuard&reg; server, and all clients.</p>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="help-card" href="https://help.valenius.com/working/" target="_blank" rel="noopener">
            <i class="bi bi-monitor hc-icon"></i>
            <h5>Working with Valenius</h5>
            <p>This admin panel explained feature by feature — what each page is for, how to use it, and the pitfalls.</p>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="help-card" href="https://help.valenius.com/working/for-users/" target="_blank" rel="noopener">
            <i class="bi bi-person-badge hc-icon"></i>
            <h5>For your users</h5>
            <p>The short end-user guide: connecting, approving MFA, sending logs. Hand this link to your users.</p>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="help-card" href="https://documentation.valenius.com/" target="_blank" rel="noopener">
            <i class="bi bi-code-slash hc-icon"></i>
            <h5>Technical documentation</h5>
            <p>Architecture and internals, for the technically curious — everything the help site deliberately leaves out.</p>
        </a>
    </div>
</div>

<div class="help-topics">
    <span class="d-block text-muted mb-2" style="font-size:.82rem;">Popular topics</span>
    <a href="https://help.valenius.com/install/first-steps/" target="_blank" rel="noopener">First steps after install</a>
    <a href="https://help.valenius.com/install/client-windows/" target="_blank" rel="noopener">Install the Windows client</a>
    <a href="https://help.valenius.com/install/integrated-server/" target="_blank" rel="noopener">Integrated WireGuard&reg; server</a>
    <a href="https://help.valenius.com/working/releases-updates/" target="_blank" rel="noopener">Releases &amp; auto-update</a>
    <a href="https://help.valenius.com/working/device-pairing/" target="_blank" rel="noopener">Device pairing (QR)</a>
    <a href="https://help.valenius.com/working/mfa/" target="_blank" rel="noopener">MFA session gating</a>
    <a href="https://help.valenius.com/working/settings/" target="_blank" rel="noopener">API-key rotation</a>
    <a href="https://help.valenius.com/working/diagnostics/" target="_blank" rel="noopener">Diagnostic logs</a>
</div>
