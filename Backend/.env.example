# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore — never commit it.

# PostgreSQL password (used by both the db service and the backend connection string)
DB_PASSWORD=change_me_strong_password

# Bootstrap admin — always-available local login for initial setup and emergency access.
# Used to sign in before (or instead of) OIDC. Change to a strong password.
# If the container restarts with a different password, the DB record is updated automatically.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# API key is NOT set via environment variable — a literal $ in a compose value is treated
# as variable substitution, corrupting keys that contain $. The key in appsettings.json
# (baked into the image) is used instead. To change it, update appsettings.json and rebuild.

# Licensing server credentials are hardcoded — no env vars needed.

# Authentik / OIDC is configured in Admin → Settings (stored in DB).
# No env vars required here for new installations.
#
# UPGRADE PATH (existing deployments that used Authentik__ env vars):
#   Keep these variables for the first restart after upgrading. They are migrated
#   automatically into the database and can be removed from .env afterward.
# AUTHENTIK_AUTHORITY=https://auth.example.com/application/o/yourapp/
# AUTHENTIK_CLIENT_ID=your_client_id_here
# AUTHENTIK_CLIENT_SECRET=your_client_secret_here
# AUTHENTIK_REDIRECT_URI=https://twister.example.com/signin-oidc

# WireGuard server stack (server/docker-compose.yml) has its own server/.env.example.
