#!/bin/bash
# pkg preinstall — stop the running daemon and the menu bar app before files are replaced.
# Runs as root during `installer -pkg`. Best-effort: a fresh install has nothing to stop.
#
# CRITICAL: during an auto-update this script stops the
# very daemon that launched the installer — which is exactly why the Updater runs `installer`
# from a detached one-shot LaunchDaemon, never as a child of valeniusd. Do not assume the
# calling daemon survives past this point.

DAEMON_LABEL="com.stranto.valenius.daemon"

# Stop the daemon (system domain).
/bin/launchctl bootout "system/${DAEMON_LABEL}" 2>/dev/null || true

# Stop the app in every logged-in GUI session, then hard-kill any stragglers.
CONSOLE_UID=$(/usr/bin/stat -f%u /dev/console 2>/dev/null)
if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" != "0" ]; then
    /bin/launchctl bootout "gui/${CONSOLE_UID}/com.stranto.valenius.app" 2>/dev/null || true
fi
/usr/bin/killall ValeniusApp 2>/dev/null || true

exit 0
