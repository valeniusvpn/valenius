<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stranto.valenius.daemon</string>

    <!-- Installed to /Library/Application Support/Valenius/bin/ by the pkg (M7). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/Valenius/bin/valeniusd</string>
    </array>

    <!-- Root privileged helper: same trust model as the Windows Service / Linux daemon. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- os.Logger goes to the unified log; these catch any early stderr before logging is up. -->
    <key>StandardOutPath</key>
    <string>/Library/Application Support/Valenius/updates/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/Valenius/updates/daemon.err.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
