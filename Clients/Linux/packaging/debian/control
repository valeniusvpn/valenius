Package: valenius
Version: 1.0.0
Section: net
Priority: optional
Architecture: all
Depends: python3 (>= 3.10),
         python3-venv,
         python3-gi,
         python3-gi-cairo,
         gir1.2-gtk-3.0,
         gir1.2-ayatana-appindicator3-0.1 | gir1.2-appindicator3-0.1,
